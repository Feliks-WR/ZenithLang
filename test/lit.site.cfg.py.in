@LIT_SITE_CFG_IN_HEADER@

import sys

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.llvm_shlib_dir = lit_config.substitute("@SHLIBDIR@")
config.llvm_shlib_ext = lit_config.substitute("@SHLIBEXT@")
config.lit_tools_dir = lit_config.substitute("@LLVM_LIT_TOOLS_DIR@")
config.zenith_obj_root = lit_config.substitute("@CMAKE_BINARY_DIR@")
config.zenith_tools_dir = lit_config.substitute("@CMAKE_BINARY_DIR@/bin")
config.target_triple = lit_config.substitute("@TARGET_TRIPLE@")

# Support substitution of the tools and build directories
config.llvm_tools_dir = config.llvm_tools_dir % lit_config.params
config.llvm_shlib_dir = config.llvm_shlib_dir % lit_config.params
config.zenith_obj_root = config.zenith_obj_root % lit_config.params
config.zenith_tools_dir = config.zenith_tools_dir % lit_config.params

# Let the main config do the real work.
lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")

