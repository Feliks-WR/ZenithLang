// Example: dependent types with constraints

// Integer with constraint: division requires non-zero divisor
divideBy : int {it != 0}
divideBy = 5

// Array type with dependent length
result : [int; 10]

// Pointer to int (can have non-null constraint)
ptr : *int
ptr = 0  // or null

// Range constraint
day : int {1..31}
day = 15

// Non-null pointer
validPtr : *int {nonnull}

// Safe division with proof
let x = 10
let y = 5 {it != 0}
let quotient = x / y

// Array access with bounds check
arr : [int; 100]
first = arr[0]
last = arr[99]

// This would require compile-time proof that i < 100:
index : int {0..99}
elem = arr[index]
