// Dependent Types Examples - Various Patterns

// Example 1: Division with non-zero denominator
safeDivide(numerator: int, denominator: int {!= 0}) -> real {
    return numerator / denominator
}

// Example 2: Percentage validation
validatePercentage(value: int {0..100}) -> int {
    return value
}

// Example 3: Positive numbers
square(x: int {> 0}) -> int {
    return x * x
}

// Example 4: Functions returning constrained values
getRandomInRange() -> int {1..10} {
    return 5
}

// Example 5: Complex function with multiple dependent type params
buildVector(x: int {>= 0}, y: int {>= 0}, z: int {>= 0}) -> int {
    return x + y + z
}

// Main demonstration
main() {
    divisor: int {!= 0}
    percentage: int {0..100}
    positive: int {> 0}
    
    divisor = 5
    percentage = 75
    positive = 10
    
    division_result = safeDivide(20, divisor)
    validated = validatePercentage(percentage)
    squared = square(positive)
    vector_sum = buildVector(1, 2, 3)
    
    print division_result
    print validated
    print squared
    print vector_sum
    
    return 0
}
