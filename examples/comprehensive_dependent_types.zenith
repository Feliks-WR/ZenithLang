// Comprehensive Dependent Types Example for Zenith Language
// Demonstrates all dependent type features

// ============================================================================
// 1. BASIC INTEGER CONSTRAINTS
// ============================================================================

// Single value
ONE : int {1}
ONE = 1

// Range constraint
age : int {0..150}
age = 42

// Predicate constraint (explicit)
day : int {it != 0}
day = 15

// Predicate constraint (implicit)
divisor : int {(!=0)}
divisor = 5

// ============================================================================
// 2. SAFE ARITHMETIC OPERATIONS
// ============================================================================

// Safe division: divisor is proven non-zero
result1 = 100 / divisor

// Safe modulo
remainder = 17 % divisor

// ============================================================================
// 3. POINTER TYPES
// ============================================================================

// Basic pointer
ptr : *int

// Non-null pointer
validPtr : *int {nonnull}

// Pointer binding via destructuring
// *x = 5  // This binds x to the dereferenced value

// Safe dereference of non-null pointer
value = *validPtr

// ============================================================================
// 4. ARRAY TYPES
// ============================================================================

// Fixed-size array
scores : [int; 10]

// Parameterized array (N is a type parameter)
buffer : [float; N]

// Array access with bounds-checked index
index : int {0..9}
score = scores[index]  // Safe: 0 <= index < 10

// ============================================================================
// 5. RANGE CONSTRAINTS
// ============================================================================

// Day of month
day_of_month : int {1..31}
day_of_month = 25

// Hour of day
hour : int {0..23}
hour = 14

// Minute
minute : int {0..59}
minute = 30

// ============================================================================
// 6. COMBINING CONSTRAINTS
// ============================================================================

// Function with dependent types
safe_divide : (x : int, y : int {(!=0)}) -> int
safe_divide = result1  // Type-checked at compile-time

// Array with range-constrained access
get_element : (arr : [int; 100], idx : int {0..99}) -> int
// Type guarantees idx is within bounds

// ============================================================================
// 7. SAFETY GUARANTEES PROVIDED BY COMPILER
// ============================================================================

// Array bounds: accessing with proven-safe index
validated_idx : int {0..9}
validated_idx = 5
safe_access = scores[validated_idx]

// Division safety: divisor is non-zero
safe_result = 100 / divisor

// Pointer safety: can safely dereference non-null pointer
safe_deref = *validPtr

// ============================================================================
// 8. COMPILE-TIME PROOF OBLIGATIONS
// ============================================================================

// These would require compile-time proofs:
// - arr[i]: proof that i < length
// - x / y: proof that y != 0
// - *ptr: proof that ptr != null
// - x % y: proof that y != 0

// ============================================================================
// 9. TYPE COMPATIBILITY
// ============================================================================

// Types must be compatible
a : int {1..10}
b : int {5..15}
// Type system can verify if a is compatible with b

// Pointer compatibility
ptr_int : *int
ptr_float : *float
// ptr_int and ptr_float are incompatible types

// ============================================================================
// 10. CONSTRAINT SATISFACTION
// ============================================================================

// These values satisfy their constraints:
valid_age = 25        // 0 <= 25 <= 150
valid_day = 15        // != 0
valid_divisor = 3     // != 0

// These would NOT satisfy constraints (compile error):
// invalid_age = 200         // 200 > 150
// invalid_day = 0           // 0 == 0 fails (!=0)
// invalid_divisor = 0       // 0 == 0 fails (!=0)

// ============================================================================
// SUMMARY
// ============================================================================

// Key Benefits:
// 1. Safety: Bounds and null checks verified at compile-time
// 2. Expressiveness: Types describe value constraints
// 3. Performance: No runtime overhead (checks at compile-time)
// 4. Clarity: Code intent explicit in types
// 5. Reliability: Entire categories of bugs prevented

// Constraint Forms:
// - Range: {min..max}
// - Single: {value}
// - Predicate (explicit): {it op value}
// - Predicate (implicit): {(op value)}
// - Named: {nonnull}

// Operations with Proof Obligations:
// - Array access [i]: i < length
// - Division /: divisor != 0
// - Modulo %: divisor != 0
// - Dereference *: pointer != null
// - Pointer arithmetic: validity checks
